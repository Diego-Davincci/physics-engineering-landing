---
/**
 * Canvas frame for the curriculum map. From md up it is a fixed-height window on a dotted
 * scope grid: the default slot is the "stage" that map-controller.ts pans, with a one-time
 * beam sweep. Below md it is a plain block and the slotted content flows normally.
 *
 * Slots:
 * - default: the stage content (moves with the camera).
 * - `overlay`: things pinned to the viewport above the stage (e.g. the hover window).
 *
 * Children can react to the map through the `group/map` variant
 * `data-beam="armed" | "on"`: before / during the power-on sweep.
 */
---

<div
  data-map-viewport
  role="region"
  aria-label="Mapa de la malla. Arrastra para moverte; con el mapa enfocado usa las flechas para pasar de semestre o subir y bajar."
  class:list={[
    'group/map relative px-4',
    'md:h-[clamp(30rem,calc(100dvh-7rem),54rem)] md:cursor-grab md:touch-pan-y md:overflow-hidden md:px-0 md:select-none data-dragging:cursor-grabbing',
    'md:bg-[radial-gradient(var(--color-graphite)_1px,transparent_1px)] md:bg-size-[24px_24px]',
    'md:border-y md:border-graphite',
  ]}
>
  <div data-map-stage class="md:absolute md:top-0 md:left-0 md:w-max md:will-change-transform">
    <!-- The beam: a vertical phosphor line that crosses the stage once. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -inset-y-6 left-0 z-10 hidden w-px bg-ice opacity-0 shadow-[0_0_14px_3px_var(--color-phosphor)] md:block md:group-data-[beam=on]/map:animate-[map-beam_1300ms_linear_both]"
    >
    </div>
    <slot />
  </div>

  <slot name="overlay" />

  <p aria-hidden="true" class="pointer-events-none absolute bottom-6 left-6 z-20 hidden type-data text-subtle lg:block">
    Arrastra para moverte · ←/→ entre semestres
  </p>
</div>

<script>
  import './map-controller';
</script>

<style is:global>
  /* Power-on sweep (map-controller.ts sets data-beam="on"). Global because the column
     animation is applied in semester-column.astro. */
  @keyframes map-beam {
    0% {
      left: 0%;
      opacity: 0;
    }
    6%,
    88% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  /* A semester lights up as the beam crosses it: dim → overbright → resting glow. */
  @keyframes map-column-on {
    0% {
      opacity: 0.1;
      filter: brightness(1);
    }
    35% {
      opacity: 1;
      filter: brightness(1.7);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }
</style>
