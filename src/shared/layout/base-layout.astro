---
import { Font } from 'astro:assets';
import '../../styles/global.css';
import Footer from './footer.astro';
import Header from './header.astro';

/**
 * Root HTML document for every page: fonts, global styles and meta tags.
 */
interface Props {
  /** Page title shown in the browser tab. */
  title: string;
  /** Meta description for search engines and link previews. */
  description?: string;
}

const {
  title,
  description = 'Ingeniería Física · UNAL Sede Medellín. Malla curricular, préstamo de equipos y a quién acudir. Iniciativa estudiantil.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-bricolage" preload={[{ weight: '400' }]} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
